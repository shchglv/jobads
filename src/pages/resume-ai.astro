---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/professions';

const NETWRK_URL = site.promo_netwrk_url;

const faq = [
  {
    q: 'Что такое NETWRK и как он помогает с резюме?',
    a: 'NETWRK — онлайн-сервис по улучшению резюме с помощью ИИ и HR-экспертов. Сервис анализирует ваше резюме по 32 критериям, по которым оценивают кандидатов ATS-системы и рекрутеры, и подсказывает, что исправить: от формулировок и структуры до «шумных» деталей, из-за которых приходят автоматические отказы.',
  },
  {
    q: 'Почему меня не зовут на собеседования, если я откликаюсь каждый день?',
    'a': 'Чаще всего причина — резюме: его не проходят ATS-фильтры или рекрутер не находит в нём нужных формулировок за 10–15 секунд просмотра. NETWRK проверяет резюме по 32 критериям отбора и показывает слабые места — после исправлений соискатели начинают получать приглашения и офферы.',
  },
  {
    q: 'Проверка резюме платная?',
    a: 'Условия проверки и тарифы NETWRK указаны на сайте сервиса. Анализ покажет, какие пункты вашего резюме не проходят отбор, — после этого вы решаете, подключать ли полное улучшение с ИИ и HR-экспертами.',
  },
  {
    q: 'Сколько стоит подписка NETWRK?',
    a: 'Стоимость зависит от выбранного тарифа и периода подписки — актуальные цены всегда указаны на сайте netwrk.ru. Оплата проходит на сайте сервиса.',
  },
  {
    q: 'Подойдёт ли сервис, если у меня нет опыта или был перерыв в работе?',
    a: 'Да. NETWRK помогает усилить резюме соискателям с любым бэкграундом: подсвечивает достижения, убирает лишнее и адаптирует текст под конкретную вакансию — в историях пользователей есть примеры кандидатов, которые после улучшения резюме прошли отбор после долгого перерыва.',
  },
  {
    q: 'NETWRK работает с hh.ru, Авито Работой и другими сайтами вакансий?',
    a: 'Да — сервис работает с любым резюме, которое вы используете при откликах: его можно загрузить или вставить текст, а улучшенную версию — использовать на hh.ru, Авито Работе и любых других площадках.',
  },
  {
    q: 'Как я узнаю, что резюме стало лучше?',
    a: 'NETWRK показывает оценку резюме по 32 критериям до и после улучшения: вы видите, какие пункты были проблемными и что именно исправлено. Многие пользователи отмечают, что автоматические отказы прекращаются и начинают приходить приглашения на собеседования.',
  },
];

const jsonld = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
});
---

<BaseLayout
  title="Улучшить резюме с ИИ онлайн — больше приглашений на собеседования"
  description="Улучшить резюме с ИИ и HR-экспертами: проверка по 32 критериям ATS, сопроводительные письма, больше приглашений на собеседования. Онлайн-сервис для соискателей."
  jsonld={`<script type="application/ld+json">${jsonld}</script>`}
>
  <div class="container">
    <nav class="breadcrumbs" aria-label="Хлебные крошки">
      <a href="/">Главная</a>
      <span class="sep">/</span>
      <span>Улучшение резюме</span>
    </nav>

    <header class="prof-header reveal">
      <div class="prof-logo" style="background:linear-gradient(135deg,#4f46e5,#7c3aed)" aria-hidden="true">📄</div>
      <div class="prof-title">
        <h1>Улучшить резюме с ИИ</h1>
        <div class="prof-tags">
          <span>ИИ + HR-эксперты</span>
          <span>Анализ по 32 критериям</span>
          <span>Для соискателей</span>
        </div>
        <div class="prof-salary" style="color:var(--brand)">Больше приглашений на собеседования</div>
      </div>
    </header>

    <div class="prof-body">
      <main class="prof-main">
        <section class="prof-block reveal">
          <h2><span class="h-ico">💡</span>Почему резюме не приносит приглашений</h2>
          <p>Вы откликаетесь на десятки вакансий, а приглашений нет? В 90% случаев дело не в вашем опыте, а в том, как резюме читают машины и рекрутеры. ATS-системы отсеивают анкеты по формальным критериям, а рекрутер тратит на каждое резюме 10–15 секунд. Если в тексте нет нужных формулировок, структуры и «сигналов» — отклик уходит в отказ, даже если вы идеально подходите.</p>
          <p><b>NETWRK</b> — сервис, который готовит резюме к реальному отбору: ИИ и HR-эксперты проверяют его по 32 критериям, по которым оценивают кандидатов, и дают конкретные исправления.</p>
        </section>

        <section class="prof-block reveal">
          <h2><span class="h-ico">🔍</span>Что проверяет сервис</h2>
          <ul class="check-list">
            <li>Проходимость резюме через ATS-системы и автофильтры</li>
            <li>Уместность лексики, сленга и формулировок для вашей сферы</li>
            <li>Структуру: заголовок, навыки, достижения, даты — всё, что видят рекрутеры</li>
            <li>«Шумные» детали, из-за которых приходят автоматические отказы</li>
            <li>Соответствие резюме вашей целевой должности и уровню</li>
          </ul>
        </section>

        <section class="prof-block reveal">
          <h2><span class="h-ico">⚡</span>Как это работает</h2>
          <ul class="check-list orange">
            <li>Загрузите резюме или вставьте текст — сервис проведёт анализ по 32 критериям</li>
            <li>Улучшите текст с помощью ИИ и рекомендаций HR-экспертов</li>
            <li>Адаптируйте резюме под конкретную вакансию и используйте при откликах</li>
            <li>Получайте больше приглашений на собеседования</li>
          </ul>
        </section>

    <section class="prof-block reveal">
      <h2><span class="h-ico">🎯</span>Под какие задачи подойдёт</h2>
      <div class="intent-grid">
        <div class="intent-card"><b>Резюме отклоняют без объяснений</b><p>Автоматические отказы чаще всего означают, что резюме не проходит ATS-фильтры. Сервис покажет, какие пункты отсеиваются, и поможет их исправить.</p></div>
        <div class="intent-card"><b>Мало откликов и приглашений на hh.ru</b><p>Усиленное резюме с правильными формулировками получает больше ответов рекрутеров — и на hh.ru, и на других площадках.</p></div>
        <div class="intent-card"><b>Возвращаюсь после перерыва в работе</b><p>Перерыв, смена сферы или первый опыт — сервис помогает подать ваш опыт так, чтобы он выглядел сильной стороной.</p></div>
        <div class="intent-card"><b>Не хватает времени на сопроводительные письма</b><p>ИИ подготовит сопроводительные под каждую вакансию за минуты — вместо часов ручной работы.</p></div>
        <div class="intent-card"><b>Хочу сменить профессию, но не знаю, как подать опыт</b><p>Перенос навыков в новую сферу — частая причина отказов. Эксперты помогут переупаковать резюме под новую должность.</p></div>
        <div class="intent-card"><b>Откликаюсь десятками, но рекрутеры не замечают</b><p>Структура, достижения и лексика — то, что рекрутер видит за 10–15 секунд. Сервис приводит резюме к стандартам, которые замечают.</p></div>
      </div>
    </section>

        <section class="prof-block reveal">
          <h2><span class="h-ico">❓</span>Частые вопросы</h2>
          <div class="faq-list">
            {faq.map((f) => (
              <details>
                <summary>{f.q}</summary>
                <p>{f.a}</p>
              </details>
            ))}
          </div>
        </section>
      </main>

      <aside class="prof-aside">
        <div class="apply-card" style="background:linear-gradient(160deg,#0f766e,#0e7490)">
          <h3>Проверить резюме</h3>
          <p>Анализ по 32 критериям ATS-систем и рекрутеров. Переход на сайт сервиса NETWRK.</p>
          <a class="btn btn-light" style="width:100%;justify-content:center" href={NETWRK_URL} target="_blank" rel="noopener nofollow">Проверить резюме ↗</a>
        </div>
        <div class="info-card">
          <div class="info-row"><span>Сервис</span><b>NETWRK</b></div>
          <div class="info-row"><span>Формат</span><b>Онлайн, подписка</b></div>
          <div class="info-row"><span>Кому подходит</span><b>Соискателям</b></div>
          <div class="info-row"><span>Оплата</span><b>На сайте сервиса</b></div>
        </div>
      </aside>
    </div>

    <section class="netwrk-cta reveal" style="margin:56px 0 70px">
      <div class="nb-card" style="grid-template-columns:1fr">
        <div class="nb-content" style="text-align:center;max-width:640px;margin:0 auto">
          <h2 style="font-size:1.7rem">Готовы получать больше приглашений?</h2>
          <p style="margin:0 auto 22px">Проверьте резюме по 32 критериям — узнайте, почему вас не зовут на собеседования, и исправьте это.</p>
          <div class="nb-actions" style="justify-content:center">
            <a class="btn btn-light" href={NETWRK_URL} target="_blank" rel="noopener nofollow">Проверить резюме ↗</a>
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
