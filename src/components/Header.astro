---
import { site } from '../data/professions';
---

<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="logo" aria-label={`${site.name} — на главную`}>
      <span class="logo-mark">💼</span>
      <span>{site.name}</span>
    </a>
    <nav class="header-nav" aria-label="Основная навигация">
      <a href="/#catalog">Каталог</a>
      <a href="/#steps">Как это работает</a>
      <a href="/#reviews">Отзывы</a>
      <a href="/#faq">Вопросы</a>
    </nav>
    <div class="header-actions">
      <a class="city-picker" href="/cities/" aria-label="Выбрать город">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
        <span data-current-city>Москва</span>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
      </a>
      <button class="theme-toggle" data-theme-toggle aria-label="Переключить тему">
        <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
        <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
      </button>
      <a href="/#catalog" class="btn btn-primary btn-sm btn-header">Подобрать работу</a>
    </div>
  </div>
</header>
