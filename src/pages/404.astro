---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Страница не найдена" description="Страница не найдена">
  <div class="container">
    <div class="notfound">
      <div class="nf-code">404</div>
      <h1>Такой страницы нет</h1>
      <p>Возможно, профессия была переименована или ссылка устарела.</p>
      <a href="/" class="btn btn-primary btn-lg">Вернуться на главную</a>
    </div>
  </div>
</BaseLayout>
